#:import StripedRow component.recorder_widget.StripedRow

<ScreenManager>:
    canvas.before:
        Color:
            rgba: app.theme_color('md3_background', app.theme_version)
        Rectangle:
            pos: self.pos
            size: self.size

<Screen>:
    canvas.before:
        Color:
            rgba: app.theme_color('md3_surface', app.theme_version)
        Rectangle:
            pos: self.pos
            size: self.size

<StripedRow>:
    canvas.before:
        Color:
            rgba: app.theme_color('md3_primary', app.theme_version)
            a: 0.1 if self.row_index % 2 == 0 else 0
        Rectangle:
            pos: self.pos
            size: self.size

<Label>:
    color: app.theme_color('md3_on_surface', app.theme_version)
    font_name: app.font_for_text(self.text)

<TextInput>:
    size_hint_y: None
    height: app.theme.md3_textinput_height
    on_text_validate: app.focus_next_form_field(self)
    background_normal: ""
    background_active: ""
    background_disabled_normal: ""
    background_color: app.theme_color('md3_surface_container', app.theme_version) if not self.disabled else app.theme_color('md3_surface_variant', app.theme_version)
    foreground_color: app.theme_color('md3_on_surface', app.theme_version)
    hint_text_color: app.theme_color('md3_on_surface_variant', app.theme_version)
    cursor_color: app.theme_color('md3_primary', app.theme_version)
    padding: [dp(12), dp(10), dp(12), dp(10)]
    font_name: app.font_for_text(self.text or self.hint_text)

<Button>:
    size_hint_y: None
    height: app.theme.md3_button_height
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: app.theme_color('md3_primary', app.theme_version) if not self.disabled else app.theme_color('md3_outline', app.theme_version)
    color: app.theme_color('md3_on_primary', app.theme_version) if not self.disabled else app.theme_color('md3_surface', app.theme_version)
    font_name: app.font_for_text(self.text)

<Spinner>:
    size_hint_y: None
    height: app.theme.md3_textinput_height
    font_name: app.font_for_text(self.text)

<SpinnerOption>:
    font_name: app.font_for_text(self.text)

<ToggleButton>:
    size_hint_y: None
    height: app.theme.md3_button_height
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: app.theme_color('md3_secondary', app.theme_version) if self.state == 'normal' else app.theme_color('md3_primary', app.theme_version)
    color: app.theme_color('md3_on_secondary', app.theme_version) if self.state == 'normal' else app.theme_color('md3_on_primary', app.theme_version)

<Popup>:
    # Solid themed sheet instead of Kivy's dark default image
    background: ""
    background_color: app.theme_color('md3_surface_container', app.theme_version)
    title_color: app.theme_color('md3_on_surface', app.theme_version)
    title_font: app.font_for_text(self.title)
    separator_color: app.theme_color('md3_primary', app.theme_version)

<TreeViewNode>:
    # File chooser rows
    color_selected: app.theme_color('md3_primary', app.theme_version)[:3] + [0.24]
    odd_color: 0, 0, 0, 0
    even_color: app.theme_color('md3_primary', app.theme_version)[:3] + [0.06]

<Accordion>:
    canvas.before:
        Color:
            rgba: app.theme_color('md3_surface_container', app.theme_version)
        Rectangle:
            pos: self.pos
            size: self.size

<AccordionItem>:
    background_normal: "atlas://data/images/defaulttheme/button"
    background_selected: "atlas://data/images/defaulttheme/button_pressed"
    canvas.before:
        Color:
            rgba: app.theme_color('md3_surface', app.theme_version)
        Rectangle:
            pos: self.pos
            size: self.size

[AccordionItemTitle@Label]:
    text: ctx.title
    color: app.theme_color('md3_on_secondary', app.theme_version) if ctx.item.collapse else app.theme_color('md3_on_primary', app.theme_version)
    halign: 'center'
    valign: 'middle'
    text_size: None, None
    canvas.before:
        Color:
            rgba: app.theme_color('md3_secondary', app.theme_version) if ctx.item.collapse else app.theme_color('md3_primary', app.theme_version)
        Rectangle:
            pos: self.pos
            size: self.size
        PushMatrix
        Translate:
            xy: self.center_x, self.center_y
        Rotate:
            angle: 90 if ctx.item.orientation == 'horizontal' else 0
            axis: 0, 0, 1
        Translate:
            xy: -self.center_x, -self.center_y
    canvas.after:
        PopMatrix

<ActionBar>:
    background_image: ""
    background_color: app.theme_color('md3_primary', app.theme_version)

<ActionView>:
    background_image: ""
    background_color: app.theme_color('md3_primary', app.theme_version)
    spacing: dp(4)
    padding: [dp(4), dp(4), dp(4), dp(4)]

<ActionButton>:
    size_hint_y: None
    height: app.theme.md3_button_height - dp(8)
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    background_color: app.theme_color('md3_secondary', app.theme_version) if not self.disabled else app.theme_color('md3_outline', app.theme_version)
    color: app.theme_color('md3_on_secondary', app.theme_version) if not self.disabled else app.theme_color('md3_surface', app.theme_version)

<ActionPrevious>:
    app_icon: "assets/images/logo_44.png"
    color: app.theme_color('md3_on_primary', app.theme_version)

<BottomBar@BoxLayout>:
    # MD3 bottom app bar container
    orientation: "horizontal"
    size_hint_y: None
    height: dp(80)
    padding: [dp(8), dp(12), dp(8), dp(12)]
    spacing: dp(8)
    canvas.before:
        Color:
            rgba: app.theme_color('md3_primary', app.theme_version)
        Rectangle:
            pos: self.pos
            size: self.size

<BottomBarItem@ButtonBehavior+BoxLayout>:
    # MD3 bottom bar action: icon above a label, shown in both orientations
    orientation: "vertical"
    icon: 0
    text: ""
    spacing: dp(4)
    # MD3 disabled content opacity
    opacity: 0.38 if self.disabled else 1
    canvas.before:
        Color:
            rgba: app.theme_color('md3_on_primary', app.theme_version)[:3] + [0.12 if self.state == 'down' else 0]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
    Label:
        markup: True
        text: app.icon_label(int(root.icon), "", True) if root.icon else ""
        font_size: sp(24)
        color: app.theme_color('md3_on_primary', app.theme_version)
    Label:
        text: root.text
        font_size: sp(12)
        size_hint_y: None
        height: self.texture_size[1]
        text_size: self.width, None
        halign: "center"
        shorten: True
        color: app.theme_color('md3_on_primary', app.theme_version)

<FabButton@Button>:
    # MD3 FAB: square "+" in portrait, extended with label in landscape
    markup: True
    size_hint: None, None
    height: dp(56)
    width: dp(56) if app.is_portrait else self.texture_size[0] + dp(40)
    font_size: sp(28) if app.is_portrait else sp(16)
    background_color: 0, 0, 0, 0
    color: app.theme_color('md3_on_secondary', app.theme_version)
    canvas.before:
        # Elevation shadow
        Color:
            rgba: 0, 0, 0, 0.2
        RoundedRectangle:
            pos: self.x, self.y - dp(2)
            size: self.size
            radius: [dp(16)]
        Color:
            rgba: app.theme_color('md3_secondary', app.theme_version)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
        # Pressed state layer
        Color:
            rgba: app.theme_color('md3_on_secondary', app.theme_version)[:3] + [0.12 if self.state == 'down' else 0]
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(16)]
