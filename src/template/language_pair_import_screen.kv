<LanguagePairImportScreen>:
    BoxLayout:
        orientation: 'vertical'

        # Header
        Label:
            text: app._('lang_pair_import_title', app.locale)
            font_size: sp(18)
            bold: True
            size_hint_y: None
            height: app.theme.md3_button_height
            padding: [dp(12), 0]
            halign: 'left'
            valign: 'middle'
            text_size: self.size

        Widget:

        # File selection, centered on the page
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: [dp(12), 0]
            spacing: dp(10)

            # File path row
            BoxLayout:
                size_hint_y: None
                height: app.theme.md3_textinput_height
                spacing: dp(8)
                Label:
                    text: app._('lang_pair_file_path', app.locale)
                    size_hint_x: None
                    # In portrait the caption moves into the input hint to leave room for the path
                    width: 0 if app.is_portrait else dp(80)
                    opacity: 0 if app.is_portrait else 1
                    halign: 'right'
                    valign: 'middle'
                    text_size: self.size
                TextInput:
                    text: root.file_path
                    multiline: False
                    on_text: root.file_path = self.text
                    hint_text: app._('lang_pair_file_path', app.locale) if app.is_portrait else '/path/to/language_pair.json'
                Button:
                    text: app._('lang_pair_browse_btn', app.locale)
                    size_hint_x: None
                    width: dp(88)
                    on_release: root.open_file_chooser()

            # Merge option
            BoxLayout:
                size_hint_y: None
                height: dp(56) if app.is_portrait else dp(40)
                spacing: dp(8)
                CheckBox:
                    active: root.merge_import
                    size_hint_x: None
                    width: dp(40)
                    on_active: root.merge_import = self.active
                Label:
                    text: app._('lang_pair_merge_import', app.locale)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            # Status label
            Label:
                text: root.status_text
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] if root.status_text else 0
                color: app.theme_color('md3_primary', app.theme_version)

        Widget:

        # MD3 bottom app bar: Back | Import
        BottomBar:
            BottomBarItem:
                icon: 0xF004D
                text: app._('button_back', app.locale)
                on_release: root.go_back()
            Widget:
            BottomBarItem:
                icon: 0xF02FA
                text: app._('lang_pair_import_btn', app.locale)
                disabled: root.is_busy
                on_release: root.do_import()
