<MainScreen>:
    RootWidget:
        id: root_widget

<RootWidget@BoxLayout>:
    orientation: "vertical"
    RecycleView:
        id: breadcrumb_view
        viewclass: "BreadcrumbWidget"
        data: []
        height: dp(30) if len(self.data) > 0 else 0
        size_hint_y: None
        RecycleBoxLayout:
            orientation: "horizontal"
            height: self.minimum_height
            size_hint_y: None
            default_size: None, dp(24)
    BoxLayout:
        size_hint_y: None
        height: dp(64)
        padding: [dp(16), dp(8), dp(16), dp(8)]
        # MD3 search bar: full-rounded surface container behind a transparent field
        BoxLayout:
            padding: [dp(12), 0]
            canvas.before:
                Color:
                    rgba: app.theme_color('md3_surface_container', app.theme_version)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [self.height / 2]
            TextInput:
                id: filter_input
                multiline: False
                hint_text: app._('search', app.locale)
                # Bound to theme_version so the theme rule does not repaint it on mode switch
                background_color: (0, 0, 0, 0) if app.theme_version >= 0 else (0, 0, 0, 0)
                on_text: root.on_filter_text(self.text)
    RecycleView:
        id: recycle_view
        viewclass: "RootItemWidget"
        size_hint_y: 1
        RecycleBoxLayout:
            default_size: None, app.theme.md3_button_height + dp(8)
            default_size_hint: 1, None
            size_hint_y: None
            height: self.minimum_height
            orientation: "vertical"
    # MD3 bottom app bar: Import / Back | primary action (FAB) | Settings
    BottomBar:
        BottomBarItem:
            # Import at root level, Back (one level up) inside a pair or category
            icon: 0xF02FA if root.navigation_level == 'main' else 0xF004D
            text: app._("lang_pair_import_btn" if root.navigation_level == 'main' else "button_back", app.locale)
            on_release:
                root.open_import() if root.navigation_level == 'main' else root.go_back()
        AnchorLayout:
            size_hint_x: None
            width: fab.width + dp(16)
            FabButton:
                id: fab
                # Contextual primary action: add pair (root), add category (pair), manage dictionaries (category)
                text: app.icon_label(0xF05DA if root.navigation_level == 'games' else 0xF0415, app._({'main': 'language_pair_add_title', 'categories': 'category_add_title', 'games': 'dictionaries_manage_title'}[root.navigation_level], app.locale), app.is_portrait)
                on_release:
                    root.primary_action()
        BottomBarItem:
            icon: 0xF0493
            text: app._("button_settings", app.locale)
            opacity: 1.0 if root.navigation_level == 'main' else 0
            disabled: root.navigation_level != 'main'
            on_release:
                app.next_screen('settings_screen')

<RootItemWidget@BoxLayout>:
    orientation: "horizontal"
    spacing: dp(8)
    padding: [0, dp(4), 0, dp(4)]
    row_index: -1
    text: ""
    source: ""
    logo: ""
    store_path: ""
    route_path: ""
    locale_from: ""
    locale_to: ""
    category_id: ""
    category_name: ""
    canvas.before:
        Color:
            rgb: app.theme_color('md3_primary', app.theme_version)[:3]
            a: 0.1 if root.row_index % 2 == 0 else 0
        Rectangle:
            pos: self.pos
            size: self.size
    Widget:
        size_hint_x: 0.05
    Button:
        markup: True
        text: app.icon_label(0xF01B4, app._('button_delete', app.locale), app.is_portrait)
        opacity: 1.0 if ((not root.route_path and root.category_id) or (root.locale_from and root.locale_to and not root.category_id and not root.route_path)) else 0
        disabled: False if ((not root.route_path and root.category_id) or (root.locale_from and root.locale_to and not root.category_id and not root.route_path)) else True
        size_hint_x: None
        width: self.texture_size[0] + dp(18) if ((not root.route_path and root.category_id) or (root.locale_from and root.locale_to and not root.category_id and not root.route_path)) else 0
        on_release:
            app.root.get_screen('main_screen').ids.root_widget.confirm_delete(root)
    Label:
        text: app._(root.text, app.locale) if root.text.startswith('game_') else root.text
        size_hint_x: 0.4
        # Wrap long names instead of overflowing neighbour buttons on narrow (portrait) rows
        text_size: self.width, None
        halign: 'center'
    Button:
        text: app._('button_play', app.locale) if root.route_path else ""
        disabled: False if root.route_path else True
        opacity: 1.0 if root.route_path else 0
        size_hint_x: 0.4 if root.route_path else 0.01
        on_release:
            app.root.get_screen('main_screen').ids.root_widget.play_game(root)
    Button:
        markup: True
        text: app.icon_label(0xF0415, app._('button_add_word', app.locale), app.is_portrait)
        opacity: 1.0 if (not root.route_path and root.category_id) else 0
        disabled: False if (not root.route_path and root.category_id) else True
        size_hint_x: None
        width: self.texture_size[0] + dp(18) if (not root.route_path and root.category_id) else 0
        on_release:
            app.root.get_screen('main_screen').ids.root_widget.add_vocabulary(root)
    Button:
        markup: True
        text: app.icon_label(0xF0207, app._('lang_pair_export_btn', app.locale), app.is_portrait)
        opacity: 1.0 if (root.locale_from and root.locale_to and not root.category_id and not root.route_path) else 0
        disabled: False if (root.locale_from and root.locale_to and not root.category_id and not root.route_path) else True
        size_hint_x: None
        width: self.texture_size[0] + dp(18) if (root.locale_from and root.locale_to and not root.category_id and not root.route_path) else 0
        on_release:
            app.root.get_screen('main_screen').ids.root_widget.open_export(root)
    Button:
        markup: True
        text: app.icon_label(0xF012C, app._('button_select', app.locale), app.is_portrait)
        opacity: 1.0 if not root.route_path else 0
        size_hint_x: None
        width: self.texture_size[0] + dp(18) if not root.route_path else 0
        on_release:
            app.root.get_screen('main_screen').ids.root_widget.update_data(root)
    Widget:
        size_hint_x: 0.05

<BreadcrumbWidget@Button>:
    text: ""
    source: ""
    cursor: "hand"
    color: app.theme_color('md3_on_surface', app.theme_version)
    width: self.texture_size[0] + dp(20)
    size_hint_x: None
    background_normal: ""
    background_down: ""
    background_disabled_normal: ""
    background_disabled_down: ""
    # hack to preserve transparent background in different modes
    background_color: (0, 0, 0, 0) if app.theme_version >= 0 else (0, 0, 0, 0)
    canvas.after:
        Color:
            rgba: app.theme_color('md3_on_surface_variant', app.theme_version)
        Triangle:
            points: (self.right - dp(5), self.y + dp(6), self.right - dp(2), self.center_y, self.right - dp(5), self.top - dp(6))
        Line:
            points: (self.x + dp(10), self.y - dp(1), self.right - dp(10), self.y - dp(1))
            width: 0.25
    on_release:
        app.root.get_screen('main_screen').ids.root_widget.load_breadcrumb(root.source)
