<LanguagePairExportScreen>:
    BoxLayout:
        orientation: 'vertical'

        # Header
        Label:
            text: app._('lang_pair_export_title', app.locale) + (' — ' + root.pair_name if root.pair_name else '')
            font_size: sp(18)
            bold: True
            size_hint_y: None
            height: app.theme.md3_button_height
            padding: [dp(12), 0]
            halign: 'left'
            valign: 'middle'
            text_size: self.size
            shorten: True

        Widget:

        # File selection, centered on the page
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: [dp(12), 0]
            spacing: dp(10)

            # Downloads path row
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
                disabled: root.use_app_folder
                Label:
                    text: app._('lang_pair_file_path', app.locale)
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    text_size: self.width, None
                BoxLayout:
                    size_hint_y: None
                    height: app.theme.md3_textinput_height
                    spacing: dp(8)
                    TextInput:
                        text: root.file_path
                        multiline: False
                        on_text: root.file_path = self.text
                        hint_text: '/path/to/language_pair.json'
                    Button:
                        text: app._('lang_pair_browse_btn', app.locale)
                        size_hint_x: None
                        width: dp(88)
                        on_release: root.open_file_chooser()

            # App folder path row (/sdcard/Android/data/<package>/files)
            BoxLayout:
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(4)
                disabled: not root.use_app_folder
                Label:
                    text: app._('lang_pair_app_folder', app.locale)
                    size_hint_y: None
                    height: self.texture_size[1]
                    halign: 'left'
                    text_size: self.width, None
                BoxLayout:
                    size_hint_y: None
                    height: app.theme.md3_textinput_height
                    spacing: dp(8)
                    TextInput:
                        text: root.app_file_path
                        multiline: False
                        on_text: root.app_file_path = self.text
                        hint_text: '/path/to/language_pair.json'
                    Button:
                        text: app._('lang_pair_browse_btn', app.locale)
                        size_hint_x: None
                        width: dp(88)
                        on_release: root.open_app_file_chooser()

            # Path source option
            BoxLayout:
                size_hint_y: None
                height: dp(56) if app.is_portrait else dp(40)
                spacing: dp(8)
                CheckBox:
                    active: root.use_app_folder
                    size_hint_x: None
                    width: dp(40)
                    on_active: root.use_app_folder = self.active
                Label:
                    text: app._('lang_pair_use_app_folder', app.locale)
                    halign: 'left'
                    valign: 'middle'
                    text_size: self.size

            # Status label
            Label:
                text: root.status_text
                halign: 'left'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1] if root.status_text else 0
                color: app.theme_color('md3_primary', app.theme_version)

        Widget:

        # MD3 bottom app bar: Back | Export
        BottomBar:
            BottomBarItem:
                icon: 0xF004D
                text: app._('button_back', app.locale)
                on_release: root.go_back()
            Widget:
            BottomBarItem:
                icon: 0xF0207
                text: app._('lang_pair_export_btn', app.locale)
                disabled: root.is_busy
                on_release: root.do_export()
